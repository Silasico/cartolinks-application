      "predictiveBackGestureEnabled": false,
      "package": "com.silasico.cartolinksmobileapplication"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a816f8b2-f3ce-4700-8911-74be848de7be"
